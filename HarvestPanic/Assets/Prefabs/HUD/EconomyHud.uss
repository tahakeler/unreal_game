/* HARVEST PANIC economy HUD — art-bible §7 "Grandpa's farm ledger": paper #F6EBD3, ink #2B2118,
   gold #F5C542 (money), tomato #E5483B (loss/blame), plum #5B2A6E (landlord/quota). */

.hp-root { position: absolute; left: 0; top: 0; right: 0; bottom: 0; }

.hp-card {
    background-color: #F6EBD3;
    border-color: #2B2118; border-width: 2px; border-radius: 6px;
    padding: 8px 14px;
    color: #2B2118;
}
.hp-shadow { border-bottom-width: 5px; border-right-width: 3px; }

/* ---- wallet (top centre) ---- */
.hp-wallet { position: absolute; top: 14px; left: 50%; translate: -50% 0; align-items: center; min-width: 340px; }
.hp-wallet-row { flex-direction: row; align-items: center; justify-content: center; }
.hp-money { font-size: 44px; color: #2B2118; -unity-text-align: middle-center; }
.hp-money-neg { color: #E5483B; }
.hp-iou { font-size: 20px; color: #FFF4D6; background-color: #E5483B; border-radius: 4px; padding: 0 6px; margin-left: 10px; }
.hp-daylabel { font-size: 22px; color: #5B2A6E; letter-spacing: 1px; }
.hp-quota-label { font-size: 22px; margin-top: 2px; }
.hp-bar { height: 16px; width: 320px; background-color: #E3D3B0; border-color: #2B2118; border-width: 2px; border-radius: 8px; margin-top: 4px; overflow: hidden; }
.hp-bar-fill { height: 100%; background-color: #5B2A6E; border-radius: 6px; }
.hp-bar-fill-done { background-color: #F5C542; }

/* ---- pocket watch (bottom left) ---- */
.hp-clock { position: absolute; left: 20px; bottom: 20px; width: 170px; height: 170px; border-radius: 85px;
    background-color: #F6EBD3; border-color: #2B2118; border-width: 4px; align-items: center; justify-content: center; }
.hp-clock-phase { font-size: 22px; color: #5B2A6E; }
.hp-clock-time { font-size: 46px; color: #2B2118; }
.hp-clock-urgent { color: #E5483B; }
.hp-clock-dusk { background-color: #F2B49A; }
.hp-clock-sub { font-size: 18px; color: #6B5A48; }

/* ---- order clipboard (top right) ---- */
.hp-order { position: absolute; right: 18px; top: 14px; width: 290px; rotate: 1.5deg; }
.hp-clip { position: absolute; top: -10px; left: 50%; translate: -50% 0; width: 70px; height: 16px; background-color: #8A6A4A; border-color: #2B2118; border-width: 2px; border-radius: 4px; }
.hp-order-title { font-size: 26px; color: #5B2A6E; -unity-text-align: middle-center; margin-top: 4px; }
.hp-order-line { flex-direction: row; justify-content: space-between; font-size: 24px; margin-top: 4px; border-bottom-width: 1px; border-color: #C9B48C; }
.hp-order-text { font-size: 24px; }
.hp-order-count { font-size: 24px; }
.hp-order-done { color: #8A7A60; }
.hp-order-tick { color: #3A8A3A; }
.hp-order-bonus { font-size: 20px; margin-top: 6px; color: #6B5A48; -unity-text-align: middle-center; }
.hp-twist { font-size: 20px; color: #5B2A6E; margin-top: 6px; -unity-font-style: italic; white-space: normal; }

/* ---- toasts ---- */
.hp-toasts { position: absolute; top: 175px; left: 50%; translate: -50% 0; align-items: center; }
.hp-toast { font-size: 30px; padding: 2px 14px; margin-top: 4px; border-radius: 6px; border-width: 2px; border-color: #2B2118; }
.hp-toast-gain { background-color: #F5C542; color: #2B2118; }
.hp-toast-loss { background-color: #E5483B; color: #FFF4D6; }
.hp-toast-disaster { background-color: #2B2118; color: #F6EBD3; font-size: 32px; }

/* ---- receipt overlay ---- */
.hp-dim { position: absolute; left: 0; top: 0; right: 0; bottom: 0; background-color: rgba(30, 20, 12, 0.55); align-items: center; justify-content: center; }
.hp-receipt { width: 620px; max-height: 96%; background-color: #F6EBD3; border-color: #2B2118; border-width: 2px; padding: 18px 26px 14px 26px; rotate: -1deg; }
.hp-receipt-zig { height: 10px; background-color: #F6EBD3; }
.hp-r-title { font-size: 40px; -unity-text-align: middle-center; color: #2B2118; }
.hp-r-sub { font-size: 22px; -unity-text-align: middle-center; color: #6B5A48; margin-bottom: 4px; }
.hp-r-rule { height: 2px; background-color: #2B2118; margin: 6px 0; }
.hp-r-dash { border-top-width: 2px; border-color: #9C8A6E; margin: 6px 0; }
.hp-r-headline { font-size: 24px; background-color: #FFF4D6; border-color: #E5483B; border-width: 2px; padding: 4px 8px; -unity-text-align: middle-center; color: #E5483B; white-space: normal; }
.hp-r-row { flex-direction: row; justify-content: space-between; }
.hp-r-text { font-size: 23px; color: #2B2118; flex-shrink: 1; white-space: normal; }
.hp-r-amt { font-size: 23px; color: #2B2118; -unity-text-align: middle-right; min-width: 110px; }
.hp-r-gain { color: #2E7D32; }
.hp-r-loss { color: #E5483B; }
.hp-r-total { font-size: 28px; }
.hp-r-section { font-size: 26px; color: #5B2A6E; margin-top: 6px; }
.hp-r-player { font-size: 25px; color: #2B2118; margin-top: 6px; }
.hp-r-line { padding-left: 16px; }
.hp-r-more { font-size: 20px; color: #6B5A48; padding-left: 16px; -unity-font-style: italic; }
.hp-r-stamp { position: absolute; right: 20px; top: 70px; font-size: 54px; rotate: -14deg; border-width: 5px; border-radius: 8px; padding: 0 12px; }
.hp-stamp-paid { color: #2E7D32; border-color: #2E7D32; }
.hp-stamp-evicted { color: #E5483B; border-color: #E5483B; }
.hp-r-buttons { flex-direction: row; justify-content: center; margin-top: 10px; }
.hp-btn { font-size: 26px; padding: 6px 22px; margin: 0 8px; background-color: #5B2A6E; color: #FFF4D6; border-color: #2B2118; border-width: 2px; border-radius: 6px; }
.hp-btn:hover { background-color: #6F3887; }
.hp-btn:focus { border-color: #F5C542; border-width: 3px; }
.hp-btn-secondary { background-color: #E3D3B0; color: #2B2118; }
.hp-btn-secondary:hover { background-color: #EADDBF; }
.hp-wait { font-size: 22px; color: #6B5A48; -unity-text-align: middle-center; margin-top: 8px; }
