/* Grandpa's tapes, captions, help table, leave-confirm. Tape = a VHS label card, top-left, never covering the crosshair. */
.overlay-root { background-color: rgba(0, 0, 0, 0); }
.tape {
    position: absolute; left: 40px; top: 40px; width: 620px;
    padding: 18px 22px 16px 22px;
    background-color: var(--paper); border-width: 4px; border-bottom-width: 8px; border-color: var(--ink); border-radius: 14px;
    rotate: -1deg;
    transition-property: opacity, translate; transition-duration: 0.18s;
}
.tape-label { flex-direction: row; align-items: center; margin-bottom: 8px; }
.tape-badge {
    font-size: var(--font-size-small); color: var(--paper); background-color: var(--ink);
    padding: 2px 10px; border-radius: 6px; margin-right: 12px;
}
.tape-title { font-size: 36px; color: var(--ink); white-space: normal; flex-shrink: 1; }
.tape-body { white-space: normal; font-size: var(--font-size-body); margin-bottom: 8px; }
.tape-hint { color: var(--ink-soft); }

.captions {
    position: absolute; left: 0; right: 0; bottom: 150px;
    align-items: center; display: none;
}
.caption-line { padding: 4px 18px; margin-top: 4px; border-radius: 10px; background-color: rgba(43, 33, 24, 0.6); color: var(--cream); font-size: var(--font-size-body); -unity-text-align: middle-center; white-space: normal; }

/* help */
.help-card { width: 1100px; }
.help-row { flex-direction: row; align-items: center; min-height: 52px; border-bottom-width: 2px; border-color: var(--paper-dark); }
.help-head { border-bottom-width: 4px; border-color: var(--ink); }
.help-cell { color: var(--ink); flex-basis: 0; flex-grow: 1; white-space: normal; padding: 4px 10px; }
.help-cell--action { flex-grow: 1.4; }
.keycap {
    -unity-text-align: middle-center; padding: 2px 10px; border-width: 3px; border-bottom-width: 5px;
    border-color: var(--ink); border-radius: 8px; background-color: var(--cream); align-self: flex-start; color: var(--ink);
}
.help-scroll { max-height: 600px; }

/* rebinding */
.bind-btn { min-width: 220px; min-height: 56px; margin: 0 0 0 10px; font-size: var(--font-size-small); }
.bind-btn--listening { background-color: var(--pumpkin); }
.bind-warning { color: var(--wood-dark); white-space: normal; margin-top: 8px; }

/* leave confirm */
.confirm-sign { width: 640px; }

/* colour-blind roots: reserved colours remapped (UiPalette mirrors these) */
.hp-root--cb-deutan, .hp-root--cb-protan { --reserved-money: #E69F00; --reserved-loss: #D55E00; --reserved-danger: #F0E442; --reserved-good: #0072B2; }
.hp-root--cb-tritan { --reserved-money: #E69F00; --reserved-loss: #C0392B; --reserved-danger: #FF5FA2; --reserved-good: #009E73; }
.hp-root--reduced-motion .tape { rotate: 0deg; transition-duration: 0s; }
