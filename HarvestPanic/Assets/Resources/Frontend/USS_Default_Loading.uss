/* Scene transition card (LoadingScreen). Display only. */
.loading-root {
    background-color: var(--wood-dark);
    background-image: url("project:///Assets/Art/UI/Textures/T_UI_PaperGrain.png"); background-repeat: repeat; background-size: 256px 256px;
    align-items: center; justify-content: center;
    opacity: 1; transition-property: opacity; transition-duration: 0.3s;
}
.loading-root.loading--out { opacity: 0; }
.loading-card { width: 1100px; padding: 46px 56px 40px 56px; rotate: -1.2deg; transition-property: scale, translate; transition-duration: 0.3s; transition-timing-function: ease-out-back; }
.loading-card--in { scale: 0.96 0.96; translate: 0 14px; }
.loading-head { align-items: center; }
.loading-title { font-size: 76px; color: var(--ink); flex-shrink: 1; white-space: normal; }
.loading-sub { font-size: 30px; color: var(--ink-soft); margin: 4px 0 24px 4px; -unity-font-definition: url("project:///Assets/Art/UI/Fonts/Nunito-ExtraBold.ttf"); }
.loading-wheel { margin-left: 24px; }
.loading-tip-card {
    background-color: #FBEFB8; border-width: 0; border-bottom-width: 6px; border-color: rgba(43, 33, 24, 0.35); border-radius: 4px;
    padding: 28px 30px 24px 30px; rotate: 1.4deg;
}
.loading-tip-head { font-size: 30px; color: var(--wood-dark); margin-bottom: 4px; }
.loading-tip { font-size: 30px; white-space: normal; -unity-font-definition: url("project:///Assets/Art/UI/Fonts/Nunito-ExtraBold.ttf"); }
.loading-footer { position: absolute; left: 0; right: 0; bottom: 36px; justify-content: center; }
.loading-logo { font-size: 44px; color: var(--paper); -unity-text-outline-width: 4px; -unity-text-outline-color: var(--ink); text-shadow: 0 4px 0 var(--ink); }
