<ui:UXML xmlns:ui="UnityEngine.UIElements" editor-extension-mode="False">
    <ui:VisualElement name="root" class="hp-root overlay-root" picking-mode="Ignore">
        <ui:VisualElement name="tape" class="tape" picking-mode="Ignore">
            <ui:VisualElement class="tape-label" picking-mode="Ignore">
                <ui:Label name="tape-badge" text="@tape.badge" class="bold tape-badge" picking-mode="Ignore" />
                <ui:Label name="tape-title" text="@tape.title" class="display tape-title" picking-mode="Ignore" />
            </ui:VisualElement>
            <ui:Label name="tape-body" text="" class="tape-body" picking-mode="Ignore" />
            <ui:Label name="tape-hint" text="" class="small-text tape-hint" picking-mode="Ignore" />
        </ui:VisualElement>
        <ui:VisualElement name="captions" class="captions" picking-mode="Ignore" />
    </ui:VisualElement>
</ui:UXML>
