<ui:UXML xmlns:ui="UnityEngine.UIElements" editor-extension-mode="False">
    <ui:VisualElement name="root" class="hp-root pause-root">
        <ui:VisualElement class="dim" picking-mode="Ignore" />
        <ui:VisualElement class="fade-left" picking-mode="Ignore" />
        <ui:VisualElement name="pause-main" class="screen" picking-mode="Ignore">
            <ui:VisualElement name="pause-card" class="paper-card pause-card">
                <ui:VisualElement class="masking-tape masking-tape--tl" picking-mode="Ignore" />
                <ui:Label name="pause-title" text="@pause.title.multi" class="display pause-title" />
                <ui:Label name="pause-sub" text="@pause.sub.multi" class="small-text muted pause-sub" />
                <ui:VisualElement class="ink-underline" />
                <ui:Button name="btn-resume" text="@pause.resume" class="hp-btn hp-btn--primary pause-btn" />
                <ui:Button name="btn-pause-settings" text="@pause.settings" class="hp-btn pause-btn" />
                <ui:Button name="btn-help" text="@pause.help" class="hp-btn pause-btn" />
                <ui:Button name="btn-invite" text="@pause.invite" class="hp-btn pause-btn" />
                <ui:Button name="btn-leave" text="@pause.leave" class="hp-btn pause-btn hp-btn--back" />
                <ui:Label name="pause-toast" text="" class="small-text pause-toast" />
            </ui:VisualElement>
            <ui:VisualElement name="pause-players" class="paper-card pause-players paper-card--tilt-r">
                <ui:VisualElement class="masking-tape masking-tape--top" picking-mode="Ignore" />
                <ui:Label text="@pause.crew" class="display card-heading" />
                <ui:VisualElement name="pause-voice" class="pause-voice" />
            </ui:VisualElement>
        </ui:VisualElement>
        <ui:VisualElement name="pause-help" class="screen centered" picking-mode="Ignore">
            <ui:VisualElement name="pause-help-host" class="settings-host" />
        </ui:VisualElement>
        <ui:VisualElement name="pause-confirm" class="screen centered" picking-mode="Ignore">
            <ui:VisualElement class="paper-card confirm-card">
                <ui:VisualElement class="masking-tape masking-tape--top" picking-mode="Ignore" />
                <ui:Label text="@pause.confirm.title" class="display dialog-title" />
                <ui:Label name="confirm-sub" text="@pause.confirm.sub" class="body-text confirm-sub" />
                <ui:VisualElement class="row dialog-buttons">
                    <ui:Button name="btn-confirm-stay" text="@common.stay" class="hp-btn hp-btn--primary hp-btn--small hp-btn--center" />
                    <ui:Button name="btn-confirm-leave" text="@pause.leave" class="hp-btn hp-btn--small hp-btn--center hp-btn--back" />
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>
        <ui:VisualElement name="pause-settings" class="screen centered" picking-mode="Ignore">
            <ui:VisualElement name="pause-settings-host" class="settings-host" />
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
