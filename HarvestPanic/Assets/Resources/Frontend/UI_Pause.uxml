<ui:UXML xmlns:ui="UnityEngine.UIElements" editor-extension-mode="False">
    <ui:VisualElement name="root" class="hp-root pause-root">
        <ui:VisualElement name="pause-main" class="screen centered">
            <ui:VisualElement class="sign pause-sign">
                <ui:Label name="pause-title" text="The farm does not pause." class="display pause-title" />
                <ui:Label name="pause-sub" text="Your farmer is standing around with a 'zzz' above their head." class="small-text on-dark" />
                <ui:Button name="btn-resume" text="Resume" class="hp-btn hp-btn--primary" />
                <ui:Button name="btn-pause-settings" text="Settings" class="hp-btn" />
                <ui:Button name="btn-invite" text="Invite Friends" class="hp-btn" />
                <ui:Button name="btn-leave" text="Leave to Title" class="hp-btn" />
                <ui:Label name="pause-toast" text="" class="small-text on-dark" />
            </ui:VisualElement>
        </ui:VisualElement>
        <ui:VisualElement name="pause-settings" class="screen centered">
            <ui:VisualElement name="pause-settings-host" class="settings-host" />
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
