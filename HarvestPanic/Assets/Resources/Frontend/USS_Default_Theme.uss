/* HARVEST PANIC frontend theme: Grandpa's farm ledger + scrapbook (art-bible section 7).
   Paper cards with fibre grain, ink outlines, masking tape, rubber stamps. Lilita One for headings, Nunito for text.
   Reserved meaning colours (gold money, tomato loss, plum landlord, lime danger) are never used for decoration here.
   Colour is never the only cue: focus = thick pumpkin tab + lift + scale, selected = sunk + thick border. */
:root, .hp-root {
    --paper: #F6EBD3;
    --paper-2: #EFE2C4;
    --paper-dark: #E3D3AA;
    --ink: #2B2118;
    --ink-soft: rgba(43, 33, 24, 0.62);
    --ink-faint: rgba(43, 33, 24, 0.22);
    --cream: #FFF4D6;
    --wood: #8A6040;
    --wood-dark: #5E3F27;
    --leaf: #7FA34A;
    --leaf-dark: #4E6E2A;
    --pumpkin: #E8782A;
    --pumpkin-light: #F49A55;
    --sky: #9ED0E6;
    --sky-dark: #5E9AB8;
    --tape: #F3E4B0;
    /* semantic, swapped by the colour-blind root classes below */
    --good: #4E8A2F;
    --good-fill: #CFE3B4;
    --alert: #C85A17;
    --font-size-body: 26px;
    --font-size-small: 24px;
    --font-size-button: 34px;
    --font-size-heading: 44px;
}

/* colour-blind roots (UiPalette mirrors these): "good" never relies on red/green */
.hp-root--cb-deutan, .hp-root--cb-protan { --good: #0072B2; --good-fill: #BFDDF0; --alert: #D55E00; --reserved-money: #E69F00; --reserved-loss: #D55E00; --reserved-danger: #F0E442; --reserved-good: #0072B2; }
.hp-root--cb-tritan { --good: #007A5A; --good-fill: #BCE6D6; --alert: #C0392B; --reserved-money: #E69F00; --reserved-loss: #C0392B; --reserved-danger: #FF5FA2; --reserved-good: #009E73; }
.hp-root--text-large { --font-size-body: 30px; --font-size-small: 27px; --font-size-button: 38px; --font-size-heading: 50px; }
.hp-root--text-small { --font-size-body: 24px; --font-size-small: 24px; --font-size-button: 31px; --font-size-heading: 40px; }

.hp-root {
    position: absolute; left: 0; top: 0; right: 0; bottom: 0;
    -unity-font-definition: url("project:///Assets/Art/UI/Fonts/Nunito-Regular.ttf");
    font-size: var(--font-size-body);
    color: var(--ink);
}
.hp-root--reduced-motion * { transition-duration: 0s; }

.display { -unity-font-definition: url("project:///Assets/Art/UI/Fonts/LilitaOne-Regular.ttf"); }
.bold { -unity-font-definition: url("project:///Assets/Art/UI/Fonts/Nunito-ExtraBold.ttf"); }
.row { flex-direction: row; align-items: center; }
.spacer { flex-grow: 1; }
.centered { align-items: center; justify-content: center; }
.body-text { font-size: var(--font-size-body); white-space: normal; }
.small-text { font-size: var(--font-size-small); white-space: normal; }
.muted { color: var(--ink-soft); }
.on-dark { color: var(--paper); }
.heading { font-size: var(--font-size-heading); -unity-font-definition: url("project:///Assets/Art/UI/Fonts/LilitaOne-Regular.ttf"); }

/* ---------- screens: fade + small rise on enter ---------- */
.screen {
    position: absolute; left: 0; top: 0; right: 0; bottom: 0; display: none;
    opacity: 1; translate: 0 0;
    transition-property: opacity, translate; transition-duration: 0.22s, 0.3s; transition-timing-function: ease-out, ease-out-back;
}
.screen.is-active { display: flex; }
.screen.is-active.is-entering { opacity: 0; translate: 0 28px; }

/* ---------- paper cards ---------- */
.paper-card {
    background-color: var(--paper);
    background-image: url("project:///Assets/Art/UI/Textures/T_UI_PaperGrain.png");
    background-repeat: repeat; background-size: 256px 256px;
    border-width: 3px; border-bottom-width: 9px; border-right-width: 5px; border-color: var(--ink); border-radius: 18px;
    padding: 26px 30px;
}
.paper-card--tilt-l { rotate: -0.8deg; }
.paper-card--tilt-r { rotate: 0.9deg; }
.paper-inset {
    background-color: var(--paper-2);
    border-width: 2px; border-color: var(--ink-faint); border-radius: 12px; padding: 12px 16px;
}
/* legacy name kept for other screens: wooden sign = dark paper card */
.sign {
    background-color: var(--wood);
    background-image: url("project:///Assets/Art/UI/Textures/T_UI_PaperGrain.png");
    background-repeat: repeat; background-size: 256px 256px;
    border-width: 3px; border-bottom-width: 10px; border-right-width: 5px; border-color: var(--ink); border-radius: 20px;
    padding: 26px 30px 22px 30px;
}

/* masking tape strips pinned to card corners */
.masking-tape {
    position: absolute; width: 150px; height: 42px;
    background-image: url("project:///Assets/Art/UI/Textures/T_UI_Tape.png");
    -unity-background-scale-mode: stretch-to-fill;
}
.masking-tape--top { top: -22px; left: 50%; translate: -75px 0; rotate: -3deg; }
.masking-tape--tl { top: -14px; left: -40px; rotate: -32deg; }
.masking-tape--tr { top: -14px; right: -40px; rotate: 30deg; }

.screen-title {
    font-size: 72px; color: var(--paper); letter-spacing: 1px;
    -unity-font-definition: url("project:///Assets/Art/UI/Fonts/LilitaOne-Regular.ttf");
    -unity-text-outline-width: 5px; -unity-text-outline-color: var(--ink);
    text-shadow: 0 6px 0 var(--ink);
}
.screen-sub {
    font-size: 28px; color: var(--paper); margin-top: 2px;
    -unity-font-definition: url("project:///Assets/Art/UI/Fonts/Nunito-ExtraBold.ttf");
    -unity-text-outline-width: 3px; -unity-text-outline-color: var(--ink); white-space: normal;
}
.card-heading { font-size: var(--font-size-heading); color: var(--ink); -unity-font-definition: url("project:///Assets/Art/UI/Fonts/LilitaOne-Regular.ttf"); }
.ink-underline {
    height: 22px; width: 260px; margin: -6px 0 10px 0;
    background-image: url("project:///Assets/Art/UI/Textures/T_UI_Underline.png");
    -unity-background-scale-mode: stretch-to-fill; -unity-background-image-tint-color: var(--pumpkin);
}
.field-label { font-size: var(--font-size-small); color: var(--ink-soft); margin: 10px 0 6px 2px; -unity-font-definition: url("project:///Assets/Art/UI/Fonts/Nunito-ExtraBold.ttf"); }

/* ---------- buttons: paper tags. Focus = pumpkin tab + lift + scale; hover = lift; press = sink ---------- */
.hp-btn {
    min-height: 72px; margin: 0 0 12px 0; padding: 0 28px;
    background-color: var(--paper);
    border-width: 3px; border-left-width: 3px; border-bottom-width: 7px; border-right-width: 4px;
    border-color: var(--ink); border-radius: 14px;
    color: var(--ink); font-size: var(--font-size-button);
    -unity-font-definition: url("project:///Assets/Art/UI/Fonts/LilitaOne-Regular.ttf");
    -unity-text-align: middle-left; white-space: nowrap;
    transition-property: translate, scale, rotate, background-color, border-bottom-width, border-left-width;
    transition-duration: 0.14s; transition-timing-function: ease-out-back;
}
.hp-btn:hover { background-color: var(--cream); translate: 6px -2px; rotate: -0.6deg; }
.hp-btn:focus { background-color: var(--cream); border-left-width: 16px; border-left-color: var(--pumpkin); translate: 10px -2px; scale: 1.03 1.03; rotate: -0.6deg; }
.hp-btn:active { scale: 0.97 0.97; translate: 4px 2px; border-bottom-width: 3px; }
.hp-btn:disabled { opacity: 0.42; translate: 0 0; scale: 1 1; rotate: 0deg; }
.hp-btn--primary { background-color: var(--pumpkin); }
.hp-btn--primary:hover, .hp-btn--primary:focus { background-color: var(--pumpkin-light); }
.hp-btn--primary:focus { border-left-color: var(--ink); }
.hp-btn--small { min-height: 58px; font-size: 28px; padding: 0 22px; margin: 0 14px 0 0; }
.hp-btn--center { -unity-text-align: middle-center; }
.hp-btn--wide { flex-grow: 1; }
.hp-btn--selected, .hp-btn.is-selected { background-color: var(--sky); border-bottom-width: 3px; border-width: 5px; translate: 0 3px; }
.hp-btn--icon { min-width: 58px; padding: 0; -unity-text-align: middle-center; }
.hp-btn__pointer {
    position: absolute; left: -38px; top: 50%; width: 22px; height: 22px; margin-top: -11px;
    background-color: var(--pumpkin); border-width: 3px; border-color: var(--ink); border-radius: 4px;
    rotate: 45deg; opacity: 0; translate: -10px 0;
    transition-property: opacity, translate; transition-duration: 0.14s;
}
.hp-btn:focus > .hp-btn__pointer { opacity: 1; translate: 0 0; }

/* chips: rounded tags for small choices (crew size, privacy, tabs) */
.hp-chip {
    min-height: 56px; min-width: 96px; padding: 0 22px; margin: 0 12px 0 0;
    border-radius: 28px; border-bottom-width: 6px;
    font-size: 27px; -unity-text-align: middle-center;
}
.hp-chip:hover { translate: 0 -2px; rotate: 0deg; }
.hp-chip:focus { translate: 0 -3px; rotate: 0deg; scale: 1.04 1.04; border-color: var(--pumpkin); border-left-color: var(--pumpkin); border-width: 4px; border-left-width: 4px; border-bottom-width: 7px; }
.hp-chip.is-selected { background-color: var(--sky); border-color: var(--ink); border-width: 5px; border-bottom-width: 5px; translate: 0 3px; }
.hp-chip.is-selected:focus { border-color: var(--pumpkin); border-left-color: var(--pumpkin); }

/* ---------- text fields ---------- */
.hp-field { margin: 4px 0 12px 0; }
.hp-field > Label { font-size: var(--font-size-small); margin-bottom: 4px; color: var(--ink-soft); min-width: 0; -unity-font-definition: url("project:///Assets/Art/UI/Fonts/Nunito-ExtraBold.ttf"); }
.hp-field .unity-base-text-field__input {
    background-color: var(--cream); color: var(--ink);
    border-width: 3px; border-bottom-width: 5px; border-color: var(--ink); border-radius: 12px;
    padding: 8px 16px; font-size: 30px; min-height: 60px; -unity-text-align: middle-left;
    -unity-font-definition: url("project:///Assets/Art/UI/Fonts/Nunito-ExtraBold.ttf");
}
.hp-field:focus .unity-base-text-field__input, .hp-field .unity-base-text-field__input:focus { border-color: var(--pumpkin); border-width: 4px; border-bottom-width: 6px; background-color: #FFFFFF; }

/* ---------- sliders ---------- */
.hp-slider { flex-grow: 1; margin: 0 18px; height: 46px; }
.hp-slider .unity-base-slider__drag-container { height: 46px; }
.hp-slider .unity-base-slider__tracker {
    height: 14px; top: 16px; background-color: var(--paper-dark);
    border-width: 3px; border-color: var(--ink); border-radius: 8px;
}
.hp-slider .unity-base-slider__dragger {
    width: 36px; height: 36px; top: 5px; margin-left: -18px;
    background-color: var(--cream); border-width: 4px; border-color: var(--ink); border-radius: 18px;
    transition-property: scale, background-color; transition-duration: 0.12s;
}
.hp-slider:focus .unity-base-slider__dragger { background-color: var(--pumpkin); scale: 1.25 1.25; }
.hp-slider:hover .unity-base-slider__dragger { scale: 1.12 1.12; }
.hp-slider .unity-base-slider__drag-container > .unity-base-slider__dragger-border { display: none; }

/* ---------- scroll views ---------- */
.unity-scroller--vertical { width: 14px; }
.unity-scroller--vertical .unity-base-slider__tracker { background-color: var(--ink-faint); border-width: 0; border-radius: 7px; }
.unity-scroller--vertical .unity-base-slider__dragger { background-color: var(--wood); border-width: 0; border-radius: 7px; }
.unity-scroller--vertical .unity-repeat-button { display: none; }

/* ---------- dialogs ---------- */
.dialog-layer {
    position: absolute; left: 0; top: 0; right: 0; bottom: 0;
    background-color: rgba(43, 33, 24, 0.62);
    align-items: center; justify-content: center;
    opacity: 1; transition-property: opacity; transition-duration: 0.18s;
}
.dialog-layer.is-entering { opacity: 0; }
.dialog-layer.is-entering .dialog-card { scale: 0.92 0.92; }
.dialog-card { width: 820px; max-width: 90%; padding: 34px 38px 28px 38px; rotate: -0.6deg; transition-property: scale; transition-duration: 0.24s; transition-timing-function: ease-out-back; }
.dialog-head { margin-bottom: 14px; }
.dialog-badge-holder { margin-right: 20px; }
.dialog-title { font-size: 50px; color: var(--ink); white-space: normal; flex-shrink: 1; }
.dialog-body { font-size: var(--font-size-body); margin-bottom: 26px; white-space: normal; }
.dialog-buttons { justify-content: flex-end; }
.dialog-buttons .hp-btn { min-width: 170px; margin: 0 0 0 14px; }
.dialog-card--error .badge { background-color: var(--alert); color: var(--paper); }
.badge {
    width: 68px; height: 68px; border-radius: 34px; border-width: 4px; border-color: var(--ink); background-color: var(--tape);
    -unity-text-align: middle-center; font-size: 44px; color: var(--ink);
    -unity-font-definition: url("project:///Assets/Art/UI/Fonts/LilitaOne-Regular.ttf");
}

/* ---------- prompts / keycaps (device aware) ---------- */
.prompt { flex-direction: row; align-items: center; margin: 0 16px; }
.keycap {
    min-width: 46px; height: 44px; padding: 0 10px; margin-right: 10px; font-size: 24px;
    -unity-text-align: middle-center; -unity-font-definition: url("project:///Assets/Art/UI/Fonts/Nunito-ExtraBold.ttf");
    background-color: var(--cream); color: var(--ink);
    border-width: 3px; border-bottom-width: 6px; border-color: var(--ink); border-radius: 9px;
}
.keycap--pad { border-radius: 22px; min-width: 44px; }
.prompt-text { font-size: var(--font-size-small); -unity-font-definition: url("project:///Assets/Art/UI/Fonts/Nunito-ExtraBold.ttf"); }
.prompt--on-dark .prompt-text { color: #FFFFFF; -unity-text-outline-width: 3px; -unity-text-outline-color: var(--ink); text-shadow: 0 2px 0 var(--ink); }
.prompt--off { opacity: 0.42; }

/* ---------- chips / stamps / tags ---------- */
.chip {
    flex-direction: row; align-items: center; background-color: var(--paper);
    border-width: 3px; border-bottom-width: 5px; border-color: var(--ink); border-radius: 22px; padding: 4px 18px; font-size: var(--font-size-small);
    -unity-font-definition: url("project:///Assets/Art/UI/Fonts/Nunito-ExtraBold.ttf");
}
.stamp {
    padding: 2px 14px; border-width: 4px; border-radius: 8px; border-color: var(--good); color: var(--good);
    font-size: 26px; rotate: -7deg; letter-spacing: 2px;
    -unity-font-definition: url("project:///Assets/Art/UI/Fonts/LilitaOne-Regular.ttf");
}
.stamp--muted { border-color: var(--ink-soft); color: var(--ink-soft); rotate: 3deg; border-width: 3px; }
.tag {
    font-size: 20px; padding: 2px 10px; margin-left: 8px; border-radius: 8px;
    background-color: var(--ink); color: var(--paper); letter-spacing: 1px;
    -unity-font-definition: url("project:///Assets/Art/UI/Fonts/Nunito-ExtraBold.ttf");
}
.tag--pumpkin { background-color: var(--pumpkin); color: var(--ink); }

/* ---------- full-screen backdrops over the 3D farm ---------- */
.fade-left {
    position: absolute; left: 0; top: 0; bottom: 0; width: 62%;
    background-image: url("project:///Assets/Art/UI/Textures/T_UI_FadeLeft.png"); -unity-background-scale-mode: stretch-to-fill;
}
.fade-bottom {
    position: absolute; left: 0; right: 0; bottom: 0; height: 190px;
    background-image: url("project:///Assets/Art/UI/Textures/T_UI_FadeBottom.png"); -unity-background-scale-mode: stretch-to-fill;
}
.vignette {
    position: absolute; left: 0; top: 0; right: 0; bottom: 0;
    background-image: url("project:///Assets/Art/UI/Textures/T_UI_Vignette.png"); -unity-background-scale-mode: stretch-to-fill;
}
.dim { position: absolute; left: 0; top: 0; right: 0; bottom: 0; background-color: rgba(43, 33, 24, 0.5); }

/* ---------- footer ---------- */
.footer {
    position: absolute; left: 0; right: 0; bottom: 0; height: 74px;
    flex-direction: row; align-items: center; padding: 0 40px 6px 40px;
}
.footer-version { font-size: 22px; color: var(--paper); -unity-text-outline-width: 3px; -unity-text-outline-color: var(--ink); -unity-font-definition: url("project:///Assets/Art/UI/Fonts/Nunito-ExtraBold.ttf"); }

/* vector widgets */
.farmer-badge--empty { opacity: 0.85; }
