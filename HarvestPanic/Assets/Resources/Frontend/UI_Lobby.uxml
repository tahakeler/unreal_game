<ui:UXML xmlns:ui="UnityEngine.UIElements" editor-extension-mode="False">
    <!-- Lobby Yard HUD + crew ledger (Tab). Every text is a string-table key (@...). -->
    <ui:VisualElement name="root" class="hp-root lobby-root" picking-mode="Ignore">

        <ui:VisualElement name="yard-sign" class="paper-card yard-sign" picking-mode="Ignore">
            <ui:VisualElement class="masking-tape masking-tape--tl" picking-mode="Ignore" />
            <ui:Label text="@lobby.yard" class="display yard-title" picking-mode="Ignore" />
            <ui:Label name="yard-sub" text="" class="bold yard-sub" picking-mode="Ignore" />
            <ui:Label name="yard-count" text="" class="bold yard-count" picking-mode="Ignore" />
        </ui:VisualElement>

        <ui:VisualElement name="crew-strip" class="row crew-strip" picking-mode="Ignore" />

        <ui:VisualElement name="toast" class="toast" picking-mode="Ignore">
            <ui:Label name="toast-text" text="" class="bold toast-text" picking-mode="Ignore" />
        </ui:VisualElement>

        <ui:VisualElement name="center-stack" class="center-stack" picking-mode="Ignore">
            <ui:Label name="countdown-label" text="@lobby.countdown" class="display countdown-label" picking-mode="Ignore" />
            <ui:VisualElement name="countdown-disc" class="countdown-disc" picking-mode="Ignore">
                <ui:Label name="countdown-number" text="3" class="display countdown-number" picking-mode="Ignore" />
            </ui:VisualElement>
            <ui:Label name="countdown-hint" text="@lobby.countdown.hint" class="bold countdown-hint" picking-mode="Ignore" />
            <ui:Label name="confirm-label" text="" class="bold confirm-label" picking-mode="Ignore" />
        </ui:VisualElement>

        <ui:VisualElement name="ready-pill" class="ready-pill" picking-mode="Ignore">
            <ui:VisualElement name="ready-box" class="ready-box" picking-mode="Ignore" />
            <ui:Label name="ready-text" text="" class="bold ready-text" picking-mode="Ignore" />
        </ui:VisualElement>

        <ui:VisualElement name="prompt-bar" class="prompt-bar" picking-mode="Ignore" />

        <ui:VisualElement name="crew-panel" class="crew-panel">
            <ui:VisualElement class="paper-card crew-card">
                <ui:VisualElement class="masking-tape masking-tape--top" picking-mode="Ignore" />
                <ui:VisualElement class="row crew-head">
                    <ui:Label text="@lobby.crew" class="display crew-title" />
                    <ui:VisualElement class="spacer" />
                    <ui:Label name="crew-count" text="" class="bold crew-count" />
                </ui:VisualElement>
                <ui:VisualElement class="ink-underline" />
                <ui:VisualElement name="crew-list" class="crew-list" />
                <ui:Label name="crew-hint" text="" class="small-text muted crew-hint" />
                <ui:VisualElement name="host-rules" class="paper-inset host-rules">
                    <ui:Label text="@lobby.rules" class="bold rules-head" />
                    <ui:VisualElement class="row rules-row">
                        <ui:Label text="@lobby.rules.countdown" class="small-text rules-label" />
                        <ui:VisualElement name="countdown-chips" class="row chip-row" />
                    </ui:VisualElement>
                    <ui:VisualElement class="row rules-buttons">
                        <ui:Button name="btn-start-day" text="@lobby.start" class="hp-btn hp-btn--primary hp-btn--small hp-btn--center" />
                        <ui:Button name="btn-invite" text="@lobby.invite" class="hp-btn hp-btn--small hp-btn--center" />
                    </ui:VisualElement>
                </ui:VisualElement>
                <ui:Label text="@lobby.chat" class="display chat-title" />
                <ui:ScrollView name="chat-log" class="chat-log" />
                <ui:TextField name="chat-input" max-length="120" class="hp-field chat-input" />
                <ui:VisualElement class="row crew-foot">
                    <ui:Button name="btn-crew-ready" text="@lobby.ready.button" class="hp-btn hp-btn--small hp-btn--center" />
                    <ui:VisualElement class="spacer" />
                    <ui:Button name="btn-crew-close" text="@common.close" class="hp-btn hp-btn--small hp-btn--center hp-btn--back" />
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
