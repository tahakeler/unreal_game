/* Lobby Yard HUD + crew ledger. */
.yard-sign { position: absolute; left: 36px; top: 30px; width: 400px; padding: 18px 24px 14px 24px; rotate: -1.5deg; }
.yard-title { font-size: 54px; color: var(--ink); }
.yard-sub { font-size: 22px; color: var(--ink-soft); margin-top: 2px; }
.yard-count { font-size: 26px; color: var(--ink); margin-top: 2px; }

.crew-strip { position: absolute; right: 34px; top: 30px; }
.strip-card {
    flex-direction: row; align-items: center; height: 74px; padding: 0 16px 0 8px; margin-left: 10px;
    background-color: var(--paper); border-width: 3px; border-bottom-width: 6px; border-color: var(--ink); border-radius: 37px;
}
.strip-card--me { border-width: 4px; border-bottom-width: 7px; }
.strip-card--empty { background-color: rgba(246, 235, 211, 0.55); border-color: rgba(43, 33, 24, 0.4); border-bottom-width: 3px; }
.strip-name { font-size: 24px; margin-left: 10px; max-width: 170px; overflow: hidden; }
.strip-ready { width: 34px; height: 34px; border-radius: 17px; border-width: 3px; border-color: var(--ink); margin-left: 10px; background-color: var(--paper-dark); align-items: center; justify-content: center; }
.strip-ready--on { background-color: var(--good); }
.farmer-badge--talking { border-width: 4px; border-color: var(--good); border-radius: 40px; }

.toast { position: absolute; top: 132px; left: 0; right: 0; align-items: center; opacity: 0; translate: 0 -10px; transition-property: opacity, translate; transition-duration: 0.22s; }
.toast.is-shown { opacity: 1; translate: 0 0; }
.toast-text { padding: 10px 34px; font-size: 28px; background-color: var(--paper); border-width: 3px; border-bottom-width: 7px; border-color: var(--ink); border-radius: 14px; rotate: -0.6deg; white-space: normal; max-width: 1100px; -unity-text-align: middle-center; }

.center-stack { position: absolute; left: 0; right: 0; top: 200px; align-items: center; }
.lobby--crew-open .center-stack { right: 820px; }
.countdown-label { font-size: 64px; color: var(--paper); -unity-text-outline-width: 6px; -unity-text-outline-color: var(--ink); text-shadow: 0 6px 0 var(--ink); display: none; }
.countdown-disc {
    display: none; width: 250px; height: 250px; border-radius: 125px; margin-top: 8px;
    background-color: var(--paper); border-width: 6px; border-bottom-width: 12px; border-color: var(--ink);
    align-items: center; justify-content: center;
    background-image: url("project:///Assets/Art/UI/Textures/T_UI_PaperGrain.png"); background-repeat: repeat; background-size: 256px 256px;
}
.countdown-number { font-size: 180px; color: var(--pumpkin); -unity-text-outline-width: 8px; -unity-text-outline-color: var(--ink); margin-top: -10px; transition-property: scale; transition-duration: 0.16s; transition-timing-function: ease-out-back; }
.countdown-number.tick { scale: 1.3 1.3; }
.countdown-hint { display: none; margin-top: 14px; font-size: 26px; color: var(--paper); -unity-text-outline-width: 3px; -unity-text-outline-color: var(--ink); }
.confirm-label {
    display: none; font-size: 34px; -unity-text-align: middle-center; white-space: normal;
    padding: 16px 40px; background-color: var(--paper); border-width: 3px; border-bottom-width: 9px; border-color: var(--ink); border-radius: 16px; rotate: -1.5deg;
}
.center-stack.is-counting .countdown-label, .center-stack.is-counting .countdown-disc, .center-stack.is-counting .countdown-hint { display: flex; }
.center-stack.is-confirming .confirm-label { display: flex; }

.ready-pill { position: absolute; left: 36px; bottom: 120px; flex-direction: row; align-items: center; padding: 8px 24px 8px 12px;
    background-color: var(--paper); border-width: 3px; border-bottom-width: 7px; border-color: var(--ink); border-radius: 30px; }
.ready-box { width: 40px; height: 40px; border-width: 3px; border-color: var(--ink); border-radius: 10px; background-color: var(--cream); margin-right: 14px; align-items: center; justify-content: center; }
.ready-box.is-ready { background-color: var(--good); }
.ready-text { font-size: 26px; }

.prompt-bar { position: absolute; bottom: 30px; left: 0; right: 0; flex-direction: row; justify-content: center; align-items: center; }
.prompt--pill { margin: 0 10px; padding: 6px 18px 6px 8px; background-color: rgba(246, 235, 211, 0.94); border-width: 3px; border-color: var(--ink); border-radius: 28px; }

/* crew ledger (Tab) */
.crew-panel { position: absolute; right: 40px; top: 118px; bottom: 96px; width: 780px; display: none; }
.crew-panel.is-active { display: flex; }
.crew-panel.is-entering { opacity: 0; translate: 40px 0; }
.crew-panel { transition-property: opacity, translate; transition-duration: 0.2s, 0.26s; transition-timing-function: ease-out, ease-out-back; }
.crew-card { flex-grow: 1; padding: 24px 28px 18px 28px; rotate: 0.6deg; }
.crew-head { align-items: flex-end; }
.crew-title { font-size: 54px; color: var(--ink); }
.crew-count { font-size: 26px; color: var(--ink-soft); margin-bottom: 8px; }
.crew-row { flex-shrink: 0; flex-direction: row; align-items: center; min-height: 74px; padding: 4px 12px; margin-bottom: 8px; background-color: var(--cream); border-width: 3px; border-bottom-width: 5px; border-color: var(--ink); border-radius: 14px; }
.crew-row--me { border-left-width: 10px; }
.crew-row--empty { background-color: rgba(255, 244, 214, 0.45); border-color: rgba(43, 33, 24, 0.35); border-bottom-width: 3px; }
.crew-names { margin-left: 14px; flex-shrink: 1; }
.crew-name { font-size: 32px; }
.crew-head, .crew-hint, .host-rules, .rules-row, .rules-buttons, .chat-title, .chat-input, .crew-foot, .crew-card > .ink-underline { flex-shrink: 0; }
.crew-row .tag { margin-left: 0; margin-right: 6px; margin-top: 2px; }
.crew-btn { min-width: 110px; min-height: 50px; font-size: 22px; margin: 0 0 0 8px; padding: 0 12px; }
.crew-row .stamp { margin-right: 10px; }
.crew-hint { margin: 2px 0 8px 2px; }
.host-rules { margin-bottom: 10px; }
.host-rules--guest { opacity: 0.6; }
.rules-head { font-size: 24px; color: var(--wood-dark); margin-bottom: 4px; }
.rules-row { margin-bottom: 6px; }
.rules-label { min-width: 150px; -unity-font-definition: url("project:///Assets/Art/UI/Fonts/Nunito-ExtraBold.ttf"); }
.rules-row .hp-chip { min-width: 84px; min-height: 48px; font-size: 22px; margin-bottom: 0; padding: 0 14px; }
.rules-row .chip-row { flex-wrap: nowrap; }
.rules-buttons .hp-btn { margin-bottom: 0; }
.chat-title { font-size: 30px; color: var(--ink); }
.chat-log { flex-grow: 1; flex-shrink: 1; min-height: 70px; background-color: var(--paper-2); border-width: 2px; border-color: var(--ink-faint); border-radius: 12px; padding: 6px 12px; }
.chat-line { align-items: flex-start; margin-bottom: 2px; }
.chat-name { font-size: 22px; margin-right: 8px; }
.chat-text { font-size: 22px; white-space: normal; flex-shrink: 1; }
.chat-input { margin-top: 8px; }
.chat-input .unity-base-text-field__input { min-height: 48px; font-size: 24px; }
.crew-foot { margin-top: 4px; }
.crew-foot .hp-btn { margin-bottom: 0; }
