/* Main menu: title, play cards, host / join forms, credits. Layout at the 1920 x 1080 reference (UiPanel scales it). */
.screens { position: absolute; left: 0; top: 0; right: 0; bottom: 0; }

/* ---------- title ---------- */
.logo-block { position: absolute; left: 92px; top: 34px; width: 980px; rotate: -4deg; }
.logo { color: var(--paper); -unity-text-outline-width: 10px; -unity-text-outline-color: var(--ink); text-shadow: 0 10px 0 var(--ink); }
.logo-1 { font-size: 128px; letter-spacing: 6px; }
.logo-2 { font-size: 184px; color: var(--pumpkin); margin-top: -40px; margin-left: 64px; letter-spacing: 6px; transition-property: scale, rotate; transition-duration: 0.35s; transition-timing-function: ease-out-back; transform-origin: 30% 60%; }
.logo-2.logo--bounce { scale: 1.06 1.06; rotate: 2deg; }
.tagline {
    align-self: flex-start; margin: 10px 0 0 40px; padding: 8px 26px; font-size: 30px;
    background-color: var(--tape); border-width: 0; rotate: 1.5deg;
    background-image: url("project:///Assets/Art/UI/Textures/T_UI_Tape.png"); -unity-background-scale-mode: stretch-to-fill;
}

.menu-card { position: absolute; left: 112px; top: 488px; width: 500px; padding: 26px 26px 14px 26px; rotate: -1deg; }
.menu-btn { min-height: 66px; margin-bottom: 10px; }
.menu-btn--play { min-height: 80px; font-size: 44px; }

.profile-chip {
    position: absolute; top: 34px; right: 48px; flex-direction: row; align-items: center;
    min-height: 0; padding: 10px 24px 10px 12px; margin: 0; border-radius: 48px; rotate: 1.2deg;
}
.profile-chip:hover, .profile-chip:focus { translate: -4px 2px; rotate: 0deg; }
.profile-text { margin-left: 14px; }
.profile-head { font-size: 20px; color: var(--ink-soft); letter-spacing: 1px; }
.profile-name { font-size: 34px; color: var(--ink); margin-top: -4px; }

.note-card {
    position: absolute; right: 74px; bottom: 116px; width: 440px; padding: 30px 28px 24px 28px;
    background-color: #FBEFB8; border-width: 0; border-bottom-width: 6px; border-color: rgba(43, 33, 24, 0.35);
    border-radius: 4px; rotate: 2.4deg;
    transition-property: opacity, translate; transition-duration: 0.4s;
}
.note-card.note--swap { opacity: 0; translate: 0 8px; }
.note-head { font-size: 30px; color: var(--wood-dark); margin-bottom: 4px; }
.note-text { font-size: 24px; white-space: normal; color: var(--ink); -unity-font-definition: url("project:///Assets/Art/UI/Fonts/Nunito-ExtraBold.ttf"); }

/* ---------- headers + buttons shared by the play/host/join screens ---------- */
.screen-header { position: absolute; left: 112px; top: 64px; right: 112px; }
.form-buttons { position: absolute; left: 112px; bottom: 108px; align-items: flex-end; }
.form-buttons .hp-btn { margin-bottom: 0; }
.back-btn { min-width: 170px; }
.go-btn { min-width: 420px; min-height: 84px; font-size: 42px; margin-left: 14px; }

/* ---------- play cards ---------- */
.play-cards { position: absolute; left: 112px; right: 112px; top: 238px; height: 520px; align-items: stretch; }
.play-card {
    flex-grow: 1; flex-basis: 0; margin: 0 16px 0 0; padding: 30px 30px 26px 30px;
    flex-direction: column; align-items: flex-start; justify-content: flex-end; white-space: normal;
    border-radius: 22px; border-bottom-width: 10px;
    background-image: url("project:///Assets/Art/UI/Textures/T_UI_PaperGrain.png"); background-repeat: repeat; background-size: 256px 256px;
}
.play-card:hover { translate: 0 -8px; rotate: -0.8deg; }
.play-card:focus { translate: 0 -12px; rotate: -0.8deg; scale: 1.03 1.03; border-left-width: 3px; border-color: var(--pumpkin); border-bottom-color: var(--ink); border-width: 5px; border-bottom-width: 12px; }
.play-card:disabled { opacity: 0.5; }
.play-card__art { flex-grow: 1; align-self: stretch; align-items: center; justify-content: center; margin-bottom: 8px; }
.play-card__title { font-size: 52px; color: var(--ink); }
.play-card__sub { font-size: 25px; white-space: normal; margin-top: 6px; color: var(--ink-soft); -unity-font-definition: url("project:///Assets/Art/UI/Fonts/Nunito-ExtraBold.ttf"); }
.play-card--host { background-color: #F7DCC2; }
.play-card--join { background-color: #DCEBEF; }
.play-card--continue { background-color: #E5EBCF; }

/* ---------- host / join forms ---------- */
.form-card { position: absolute; left: 112px; top: 214px; width: 980px; padding: 22px 34px 26px 34px; }
.farm-field .unity-base-text-field__input { font-size: 34px; -unity-font-definition: url("project:///Assets/Art/UI/Fonts/LilitaOne-Regular.ttf"); }
.chip-row { flex-wrap: wrap; margin: 2px 0 4px 0; }
.chip-row .hp-chip { margin-bottom: 8px; }
.note-line { margin: 4px 0 2px 2px; }
.continue-box { margin-top: 16px; }
.continue-head { font-size: 24px; color: var(--wood-dark); }

.join-card { width: 1080px; }
.tab-row { margin-bottom: 18px; }
.tab-row .hp-chip { min-width: 190px; }
.join-pane { display: none; }
.join-pane.is-active { display: flex; }
.pane-head { margin-bottom: 8px; }
.pane-icon { width: 96px; height: 96px; margin-right: 18px; }
.pane-icon--small { width: 58px; height: 58px; margin-right: 12px; }
.pane-status { font-size: 30px; -unity-font-definition: url("project:///Assets/Art/UI/Fonts/Nunito-ExtraBold.ttf"); flex-shrink: 1; }
.pane-hint { margin: 6px 0 14px 2px; }
.pane-btn { align-self: flex-start; }
.lan-searching { margin-right: 14px; }
.lan-list { height: 340px; background-color: var(--paper-2); border-width: 3px; border-color: var(--ink); border-radius: 12px; padding: 6px; }
.lan-empty { margin-top: 10px; }
.lan-row {
    flex-direction: row; align-items: center; min-height: 82px; margin: 0 0 8px 0; padding: 0 18px;
    border-width: 3px; border-bottom-width: 5px; border-radius: 12px; font-size: 26px;
}
.lan-row:hover { translate: 4px 0; rotate: 0deg; }
.lan-row:focus { translate: 6px 0; rotate: 0deg; scale: 1 1; border-left-width: 14px; }
.lan-row--blocked { opacity: 0.55; }
.lan-row__names { flex-grow: 1; flex-shrink: 1; }
.lan-row__name { font-size: 32px; color: var(--ink); -unity-font-definition: url("project:///Assets/Art/UI/Fonts/LilitaOne-Regular.ttf"); }
.lan-row__host { font-size: 22px; color: var(--ink-soft); -unity-font-definition: url("project:///Assets/Art/UI/Fonts/Nunito-ExtraBold.ttf"); }
.lan-row__seats { flex-direction: row; margin: 0 14px; }
.seat { width: 22px; height: 22px; border-radius: 11px; border-width: 3px; border-color: var(--ink); margin-left: 6px; background-color: var(--paper); }
.seat--taken { background-color: var(--ink); }
.lan-row__count { font-size: 24px; min-width: 70px; -unity-text-align: middle-right; -unity-font-definition: url("project:///Assets/Art/UI/Fonts/Nunito-ExtraBold.ttf"); }
.join-row { align-items: flex-start; }
.join-field { flex-grow: 1; margin-right: 14px; margin-top: 0; }
.join-row .hp-btn { margin-top: 2px; min-height: 62px; }

/* ---------- footer (menu) ---------- */
.mode-chip { padding: 4px 18px 4px 12px; }
.mode-dot { width: 16px; height: 16px; border-radius: 8px; border-width: 3px; border-color: var(--ink); background-color: var(--sky); margin-right: 10px; }
.mode-chip--steam .mode-dot { background-color: var(--good); }
.footer-prompts { align-items: center; }

/* ---------- settings / credits hosts ---------- */
.settings-host { width: 1560px; height: 900px; align-items: center; justify-content: center; }
.credits-card { width: 1260px; }
.credits-scroll { max-height: 650px; min-height: 420px; }
.credits-heading { font-size: 34px; color: var(--wood-dark); margin: 12px 0 4px 0; -unity-font-definition: url("project:///Assets/Art/UI/Fonts/LilitaOne-Regular.ttf"); }
.credits-para { font-size: var(--font-size-small); white-space: normal; margin-bottom: 10px; }
