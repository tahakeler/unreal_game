# === Build Output ===
# Anchored to the repo root: on macOS core.ignorecase=true makes `build/` also
# match Unreal's HarvestPanic/Build/ (platform icons/config, which IS tracked).
/build/
/builds/
/bin/
/obj/
/out/
/dist/
*.exe
*.dll
*.so
*.dylib
*.app

# === Engine: Unreal (HARVEST PANIC — project lives in HarvestPanic/) ===
# Unanchored dir patterns match at any depth: HarvestPanic/Binaries/,
# HarvestPanic/Plugins/<Plugin>/Intermediate/, etc.
Binaries/
Intermediate/
Saved/
DerivedDataCache/
**/Build/Receipts/
**/Platforms/*/Binaries/
**/Platforms/*/Intermediate/
ArchivedBuilds/
StagedBuilds/
